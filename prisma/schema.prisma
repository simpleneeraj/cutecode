generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  ELITE
  ULTIMATE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
  EXPIRED
  INCOMPLETE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
  CHARGEBACK
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum AuditAction {
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_REACTIVATED
  PLAN_UPGRADED
  PLAN_DOWNGRADED
  PLAN_DOWNGRADE_SCHEDULED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  CHARGEBACK_OPENED
  ACCESS_GRANTED
  ACCESS_REVOKED
  GRACE_PERIOD_STARTED
  DUNNING_EMAIL_SENT
  WEBHOOK_RECEIVED
  IDEMPOTENCY_HIT
  TRIAL_STARTED
  TRIAL_ENDED
}

enum ShareTarget {
  SNIPPET
  PRESENTATION
  COLLECTION
}

enum ShareVisibility {
  PUBLIC
  UNLISTED
  PASSCODE
  PRIVATE
}

model User {
  id      String  @id @default(cuid())
  clerkId String  @unique
  email   String  @unique
  name    String?
  role    Role    @default(USER)
  plan    Plan    @default(FREE)

  subscription     Subscription?
  snippets         Snippet[]
  payments         Payment[]
  usageEvents      UsageEvent[]
  auditLogs        AuditLog[]
  dunningAttempts  DunningAttempt[]
  presentations    Presentation[]
  shareLinks       ShareLink[]
  shareAccess      ShareLinkAccess[]
  snippetComments  SnippetComment[]
  snippetUpvotes   SnippetUpvote[]
  snippetBookmarks SnippetBookmark[]

  followers UserFollows[] @relation("UserFollowedBy")
  following UserFollows[] @relation("UserFollows")

  usageMonth Int      @default(0)
  usageReset DateTime @default(now())

  lastIpHash String?
  deviceFp   String?
  trialUsed  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([clerkId])
}

model UserFollows {
  followerId  String
  follower    User   @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("UserFollowedBy", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  dodoSubscriptionId String  @unique
  dodoCustomerId     String?

  plan   Plan
  status SubscriptionStatus @default(INCOMPLETE)

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  gracePeriodEnd    DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?

  scheduledPlan   Plan?
  scheduledPlanAt DateTime?

  trialStart DateTime?
  trialEnd   DateTime?

  lastEventSeq Int       @default(0)
  lastEventAt  DateTime?

  payments        Payment[]
  dunningAttempts DunningAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([gracePeriodEnd])
  @@index([scheduledPlanAt])
}

model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  dodoPaymentId  String @unique
  idempotencyKey String @unique

  amount   Int
  currency String        @default("USD")
  status   PaymentStatus

  refundedAmount Int       @default(0)
  refundedAt     DateTime?
  refundReason   String?

  disputedAt   DateTime?
  disputeId    String?
  chargebackAt DateTime?

  periodStart DateTime?
  periodEnd   DateTime?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
}

model WebhookEvent {
  id         String             @id
  type       String
  status     WebhookEventStatus @default(PENDING)
  rawPayload Json

  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  processedAt   DateTime?
  errorMessage  String?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model UsageEvent {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature String

  quantity Int @default(1)

  occurredAt    DateTime
  billingWindow String

  idempotencyKey String? @unique
  isBackdated    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, billingWindow])
  @@index([userId, feature])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  metadata  Json?
  ipHash    String?
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model DunningAttempt {
  id             String       @id
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  attemptNumber Int
  scheduledAt   DateTime
  sentAt        DateTime?
  emailType     String
  succeeded     Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([subscriptionId])
  @@index([scheduledAt])
  @@index([sentAt])
}

model IdempotencyKey {
  id         String   @id
  action     String
  userId     String
  resultCode Int?
  resultBody Json?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Snippet {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  // ID of the element inside Presentation.elements Json
  elementId String

  title       String?
  description String?
  tags        String[] @default([])
  isPublic    Boolean @default(false)

  // E2E — content is inside the element blob, flag lives here for fast filtering
  isE2EEncrypted Boolean @default(false)
  encryptionHint String?

  shareLinks ShareLink[]
  comments   SnippetComment[]
  upvotes    SnippetUpvote[]
  bookmarks  SnippetBookmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([presentationId])
}

// ─────────────────────────────────────────────
// Presentation editor
// ─────────────────────────────────────────────

model Presentation {
  id           String  @id @default(cuid())
  name         String
  width        Int     @default(680)
  isPublic     Boolean @default(false)
  thumbnailUrl String?

  slides        Json
  elements      Json
  slideElements Json

  snippets   Snippet[]
  shareLinks ShareLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// Share links
// ─────────────────────────────────────────────

model ShareLink {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug           String          @unique
  targetType     ShareTarget
  targetId       String
  snippetId      String?
  snippet        Snippet?        @relation(fields: [snippetId], references: [id], onDelete: SetNull)
  presentationId String?
  presentation   Presentation?   @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  visibility     ShareVisibility @default(PUBLIC)
  passcodeHash   String?
  isE2EEncrypted Boolean         @default(false)
  encryptionHint String?
  maxViews       Int?
  viewCount      Int             @default(0)
  expiresAt      DateTime?
  allowDownload  Boolean         @default(true)
  allowCopy      Boolean         @default(true)
  indexable      Boolean         @default(false)

  views   ShareLinkView[]
  granted ShareLinkAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([userId])
  @@index([targetType, targetId])
  @@index([expiresAt])
}

// Analytics — one row per view event
model ShareLinkView {
  id          String    @id @default(cuid())
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  // Hashed IP — no raw PII stored
  ipHash    String?
  userAgent String?
  referer   String?

  // Was a passcode successfully used for this view?
  passcodeUsed Boolean @default(false)

  viewedAt DateTime @default(now())

  @@index([shareLinkId, viewedAt])
}

// Explicit user-to-user access grants (for PRIVATE links shared with specific users)
model ShareLinkAccess {
  id          String    @id @default(cuid())
  shareLinkId String
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  grantedToUserId String
  grantedTo       User   @relation(fields: [grantedToUserId], references: [id], onDelete: Cascade)

  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  @@unique([shareLinkId, grantedToUserId])
  @@index([grantedToUserId])
}

model SnippetComment {
  id        String   @id @default(cuid())
  snippetId String
  snippet   Snippet  @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([snippetId, createdAt])
  @@index([userId])
}

model SnippetUpvote {
  id        String   @id @default(cuid())
  snippetId String
  snippet   Snippet  @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([snippetId, userId])
  @@index([snippetId])
}

model SnippetBookmark {
  id        String   @id @default(cuid())
  snippetId String
  snippet   Snippet  @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([snippetId, userId])
  @@index([snippetId])
  @@index([userId])
}
